---
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/plus-jakarta-sans";
import "../styles/global.css";

import { getImage } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingWa from "../components/FloatingWa.astro";
import CartDrawer from "../components/CartDrawer.astro";
import { business } from "../data/business";
import { products } from "../data/catalog";

interface Props {
  title?: string;
  description?: string;
  /** Objek schema.org yang dirender sebagai JSON-LD halaman ini. */
  jsonLd?: object[];
  /** Tombol WA mengambang (dimatikan di halaman form agar tidak menutupi CTA). */
  floatingWa?: boolean;
}

const {
  title = `${business.name} — Kelemben Khas Banjarmasin`,
  description = business.description,
  jsonLd = [],
  floatingWa = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.jpg", Astro.site);

// Metadata produk untuk keranjang (client): sumber tunggal dari catalog.ts.
const produkClient = await Promise.all(
  products.map(async (p) => {
    const img = await getImage({
      src: p.images[0],
      width: 160,
      height: 160,
      fit: "cover",
      format: "webp",
    });
    return {
      id: p.id,
      slug: p.slug,
      name: p.name,
      priceFrom: p.priceFrom,
      image: img.src,
    };
  }),
);

const clientData = { phone: business.phone, produk: produkClient };
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
    <noscript>
      <style>
        html [data-fab] {
          opacity: 1;
          transform: none;
          pointer-events: auto;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a
      href="#konten"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-full focus:bg-cokelat focus:px-5 focus:py-3 focus:text-susu"
    >Lewati ke konten utama</a>
    <Header />
    <main id="konten">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    {floatingWa && <FloatingWa />}
    <p class="sr-only" aria-live="polite" aria-atomic="true" data-cart-live></p>
    <script type="application/json" id="data-toko" set:html={JSON.stringify(clientData)} />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
