---
import { business } from "../data/business";
import { waLink } from "../lib/wa";
import WaIcon from "./WaIcon.astro";

const waGeneral = business.phone
  ? waLink(business.phone, business.orderTemplate.replace("{flavor}", "yang tersedia"))
  : "";
---
{waGeneral && (
  <a
    data-fab
    href={waGeneral}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Pesan via WhatsApp"
    class="fixed bottom-5 right-5 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-mentega text-cokelat shadow-[0_18px_36px_-12px_rgba(42,22,8,0.55)] hover:bg-[#e0a52c]"
  >
    <WaIcon class="h-7 w-7" />
  </a>
)}
