---
import { Image } from "astro:assets";
import textureImg from "../assets/about-texture.jpg";

const values = [
  {
    title: "Resep warisan",
    text: "Rasa kelemben yang dijaga konsisten dari satu loyang ke loyang berikutnya — manis lembut dengan aroma yang akrab.",
  },
  {
    title: "Dipanggang harian",
    text: "Fresh dari oven setiap hari, jadi kelemben yang Anda terima selalu baru.",
  },
  {
    title: "Bahan pilihan",
    text: "Bahan dipilih untuk menghasilkan tekstur yang lembut dan rasa yang seimbang.",
  },
];
---
<section id="tentang" class="bg-butter/60 py-16 md:py-24">
  <div class="mx-auto grid max-w-[1200px] items-center gap-12 px-5 md:grid-cols-2">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-caramel">Tentang kami</p>
      <h2 class="mt-3 font-display text-[clamp(2rem,5vw,3.25rem)] font-semibold leading-tight text-balance">
        Kelemben yang dipanggang dengan sabar
      </h2>

      <div class="mt-6 space-y-4 text-lg leading-relaxed text-cocoa/85">
        <p>
          Wadai kelemben adalah kue bolu khas Banjar — bertekstur lembut, manisnya pas,
          dan akrab sebagai teman minum teh maupun buah tangan untuk orang terdekat.
        </p>
        <p>
          Di Bolu Dadang, kelemben dipanggang setiap hari dan bisa langsung Anda ambil
          di lokasi kami di Banjarmasin. Lebih suka diantar? Kami kirimkan lewat Gojek,
          Grab, atau ekspedisi.
        </p>
      </div>

      <div class="mt-8 grid gap-4">
        {values.map((v) => (
          <article class="rounded-2xl bg-cream/80 p-5 shadow-[0_16px_30px_-24px_rgba(46,27,15,0.5)]">
            <h3 class="font-display text-lg font-semibold text-cocoa">{v.title}</h3>
            <p class="mt-1.5 leading-relaxed text-cocoa/75">{v.text}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="relative">
      <div
        class="absolute inset-0 -translate-x-3 translate-y-3 rounded-[1.75rem] bg-marigold/35"
        aria-hidden="true"
      >
      </div>
      <Image
        src={textureImg}
        alt="Tekstur lembut kelemben Bolu Dadang dari dekat"
        widths={[480, 960]}
        sizes="(min-width: 768px) 45vw, 100vw"
        loading="lazy"
        class="relative aspect-[4/5] w-full rounded-[1.75rem] object-cover shadow-[0_40px_70px_-45px_rgba(46,27,15,0.6)]"
      />
    </div>
  </div>
</section>
