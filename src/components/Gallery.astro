---
import { Image } from "astro:assets";
import g1 from "../assets/gallery/01.jpg";
import g2 from "../assets/gallery/02.jpg";
import g3 from "../assets/gallery/03.jpg";
import g4 from "../assets/gallery/04.jpg";
import g5 from "../assets/gallery/05.jpg";
import g6 from "../assets/gallery/06.jpg";

const photos = [
  { src: g1, alt: "Sepotong bolu kelemben di piring krem dengan segelas teh" },
  { src: g2, alt: "Bolu kelemben utuh dibungkus kertas roti dan tali" },
  { src: g3, alt: "Adonan bolu kelemben dengan telur, tepung, dan whisk" },
  { src: g4, alt: "Tekstur crumb bolu kelemben dari dekat" },
  { src: g5, alt: "Tumpukan irisan bolu kelemben di atas daun pisang" },
  { src: g6, alt: "Bolu kelemben dalam kotak kertas kraft" },
];
---
<section id="galeri" class="py-16 md:py-24">
  <div class="mx-auto max-w-[1200px] px-5">
    <h2 class="max-w-2xl text-[clamp(2.1rem,5.5vw,3.5rem)] font-semibold leading-[1.08] text-balance">
      Lihat kelemben kami lebih dekat
    </h2>

    <div class="mt-12 grid grid-cols-2 gap-5 md:grid-cols-3 md:gap-7">
      {photos.map((photo, i) => (
        <figure
          class:list={[
            "overflow-hidden border-4 border-susu shadow-[0_24px_48px_-32px_rgba(42,22,8,0.6)]",
            i === 0 && "col-span-2 md:col-span-2 md:row-span-2",
            i % 2 === 0 ? "rotate-[-0.8deg]" : "rotate-[0.8deg]",
            i % 3 === 1 && "md:translate-y-3",
          ]}
        >
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[360, 720]}
            sizes={i === 0 ? "(min-width: 768px) 62vw, 100vw" : "(min-width: 768px) 30vw, 46vw"}
            loading="lazy"
            class:list={[
              "w-full object-cover",
              i === 0 ? "aspect-square md:h-full md:aspect-auto md:min-h-[420px]" : "aspect-[4/3]",
            ]}
          />
        </figure>
      ))}
    </div>
  </div>
</section>
