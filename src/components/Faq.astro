---
import { business } from "../data/business";
import Accordion from "./Accordion.astro";

interface Props {
  heading?: string;
}

const { heading = "Pertanyaan yang sering ditanya" } = Astro.props;
---
<div>
  <h2 class="text-[clamp(1.9rem,4.5vw,2.8rem)] font-semibold leading-tight">{heading}</h2>
  <div class="mt-8 border-t border-cokelat/12">
    {business.faqs.map((faq) => (
      <Accordion summary={faq.question}>
        <p>{faq.answer}</p>
      </Accordion>
    ))}
  </div>
</div>
