---
import { business } from "../data/business";
---
<section id="faq" class="bg-butter/60 py-16 md:py-24">
  <div class="mx-auto max-w-[760px] px-5">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-caramel">FAQ</p>
      <h2 class="mt-3 font-display text-[clamp(2rem,5vw,3.25rem)] font-semibold leading-tight text-balance">
        Pertanyaan yang sering ditanya
      </h2>
    </div>

    <div class="mt-8 divide-y divide-cocoa/10">
      {business.faqs.map((faq) => (
        <details class="group">
          <summary class="flex min-h-11 items-center justify-between gap-4 py-5 text-left">
            <h3 class="text-lg font-semibold text-cocoa">{faq.question}</h3>
            <span
              class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-marigold/35 text-cocoa transition-transform motion-safe:duration-300 group-open:rotate-45"
              aria-hidden="true"
            >
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M8 3v10M3 8h10"></path>
              </svg>
            </span>
          </summary>
          <p class="pb-6 pr-10 leading-relaxed text-cocoa/80">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
