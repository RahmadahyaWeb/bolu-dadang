---
import { Image } from "astro:assets";
import { business } from "../data/business";
import { waLink } from "../lib/wa";
import WaIcon from "./WaIcon.astro";

const items = business.products.map((p) => ({
  ...p,
  link: business.phone
    ? waLink(business.phone, business.orderTemplate.replace("{flavor}", p.flavor))
    : "",
}));
---
<section id="menu" class="py-16 md:py-24">
  <div class="mx-auto max-w-[1200px] px-5">
    <h2 class="max-w-2xl text-[clamp(2.1rem,5.5vw,3.5rem)] font-semibold leading-[1.08] text-balance">
      Empat rasa yang dipanggang rutin
    </h2>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-cokelat/85">
      Pilih favorit Anda — setiap varian dipesan langsung lewat WhatsApp,
      dengan harga dan ketersediaan dikonfirmasi saat chat.
    </p>

    <div class="mt-12 space-y-12 md:space-y-16">
      {items.map((product, i) => (
        <article class="grid items-center gap-7 md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:gap-12">
          <figure class:list={["relative", i % 2 === 1 && "md:order-2"]}>
            <Image
              src={product.image}
              alt={product.alt}
              widths={[420, 820]}
              sizes="(min-width: 768px) 42vw, 100vw"
              loading="lazy"
              class:list={[
                "aspect-[4/3] w-full border-[6px] border-susu object-cover shadow-[0_30px_60px_-38px_rgba(42,22,8,0.6)]",
                i % 2 === 0 ? "rotate-[-0.8deg]" : "rotate-[0.8deg]",
              ]}
            />
            {product.badge && (
              <span class="absolute -right-2 top-4 rotate-[-7deg] border-2 border-cokelat bg-mentega px-3 py-1 text-sm font-semibold text-cokelat shadow-sm">
                {product.badge}
              </span>
            )}
          </figure>

          <div>
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
              <h3 class="text-[clamp(1.65rem,4vw,2.35rem)] font-semibold leading-tight">
                {product.name}
              </h3>
              <span class="leader hidden sm:block" aria-hidden="true"></span>
              <span class="whitespace-nowrap text-lg font-semibold text-pandan">Tanya harga</span>
            </div>

            <p class="mt-3 max-w-xl text-lg leading-relaxed text-cokelat/85">
              {product.description}
            </p>

            {product.link && (
              <a
                href={product.link}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-pandan mt-6"
              >
                <WaIcon class="h-4 w-4" />
                <span>Pesan via WhatsApp</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
