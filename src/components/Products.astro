---
import { Image } from "astro:assets";
import { business } from "../data/business";
import { waLink } from "../lib/wa";
import WaIcon from "./WaIcon.astro";

const items = business.products.map((p) => ({
  ...p,
  link: business.phone
    ? waLink(business.phone, business.orderTemplate.replace("{flavor}", p.flavor))
    : "",
}));
---
<section id="menu" class="py-16 md:py-24">
  <div class="mx-auto max-w-[1200px] px-5">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-caramel">Varian rasa</p>
      <h2 class="mt-3 font-display text-[clamp(2rem,5vw,3.25rem)] font-semibold leading-tight text-balance">
        Empat rasa yang dipanggang rutin
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-cocoa/80">
        Pilih favorit Anda — setiap varian dipesan langsung lewat WhatsApp,
        dengan harga dan ketersediaan dikonfirmasi saat chat.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {items.map((product) => (
        <article class="group flex flex-col overflow-hidden rounded-3xl border border-caramel/15 bg-butter/45 shadow-[0_24px_50px_-32px_rgba(46,27,15,0.55)]">
          <div class="relative aspect-[4/3] overflow-hidden">
            <Image
              src={product.image}
              alt={product.alt}
              widths={[420, 820]}
              sizes="(min-width: 768px) 50vw, 100vw"
              loading="lazy"
              class="h-full w-full object-cover transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.04]"
            />
            {product.badge && (
              <span class="absolute left-4 top-4 rounded-full bg-marigold px-3.5 py-1.5 text-xs font-semibold tracking-wide text-cocoa shadow-sm">
                {product.badge}
              </span>
            )}
          </div>

          <div class="flex flex-1 flex-col p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-caramel">
              {product.flavor}
            </p>
            <h3 class="mt-1.5 font-display text-2xl font-semibold text-cocoa">{product.name}</h3>
            <p class="mt-2.5 leading-relaxed text-cocoa/80">{product.description}</p>

            {product.link && (
              <div class="mt-auto pt-5">
                <a
                  href={product.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center gap-2.5 rounded-full bg-pandan px-6 py-2.5 font-semibold text-cream transition-transform motion-safe:duration-300 motion-safe:hover:-translate-y-0.5"
                >
                  <WaIcon class="h-4 w-4" />
                  <span>Pesan via WhatsApp</span>
                </a>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
