---
import { business } from "../data/business";
---
<section id="testimoni" class="py-16 md:py-24">
  <div class="mx-auto max-w-[1200px] px-5">
    <h2 class="max-w-2xl text-[clamp(2.1rem,5.5vw,3.5rem)] font-semibold leading-[1.08] text-balance">
      Kata mereka yang sudah mencoba
    </h2>
    {business.testimonialsAreExamples && (
      <p class="mt-5 inline-block border-l-4 border-mentega bg-susu px-4 py-2.5 text-sm font-medium text-cokelat/85">
        Kutipan di bawah adalah contoh tampilan. Ulasan asli dari pelanggan akan menyusul.
      </p>
    )}

    <div class="mt-12 grid gap-6 md:grid-cols-[1.6fr_1fr]">
      {business.testimonials.map((t, i) => (
        <figure
          class:list={[
            "flex h-full flex-col border-2 border-cokelat/15 bg-susu p-7 shadow-[0_24px_50px_-36px_rgba(42,22,8,0.55)]",
            i === 0 && "md:row-span-2 md:justify-center md:p-10",
          ]}
        >
          <span
            class:list={["display leading-none text-mentega", i === 0 ? "text-6xl" : "text-4xl"]}
            aria-hidden="true"
          >&ldquo;</span>
          <blockquote
            class:list={[
              "mt-3 flex-1 leading-relaxed text-cokelat/90",
              i === 0 ? "text-2xl md:text-[1.75rem]" : "text-lg",
            ]}
          >
            {t.quote}
          </blockquote>
          <figcaption class="mt-6 flex flex-wrap items-center gap-3">
            <span class="font-semibold text-cokelat">{t.author}</span>
            {business.testimonialsAreExamples && (
              <span class="rounded-full border border-karamel/50 px-3 py-1 text-xs font-semibold text-karamel">
                Contoh
              </span>
            )}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
