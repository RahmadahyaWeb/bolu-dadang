---
interface Props {
  id: string;
  value?: number;
  label?: string;
}

const { id, value = 1, label = "Jumlah" } = Astro.props;
---
<div class="inline-flex items-center rounded-full border border-cokelat/25" data-stepper>
  <button
    type="button"
    data-step="-1"
    aria-label="Kurangi jumlah"
    class="inline-flex h-11 w-11 items-center justify-center rounded-full transition-colors hover:bg-cokelat/8"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true" focusable="false">
      <path d="M5 12h14" stroke-linecap="round"></path>
    </svg>
  </button>
  <input
    type="number"
    inputmode="numeric"
    min="1"
    max="20"
    value={value}
    id={id}
    name="qty"
    data-qty
    aria-label={label}
    class="h-11 w-12 border-0 bg-transparent text-center text-base font-semibold"
  />
  <button
    type="button"
    data-step="1"
    aria-label="Tambah jumlah"
    class="inline-flex h-11 w-11 items-center justify-center rounded-full transition-colors hover:bg-cokelat/8"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true" focusable="false">
      <path d="M12 5v14M5 12h14" stroke-linecap="round"></path>
    </svg>
  </button>
</div>
