---
import { business } from "../data/business";
import { waLink } from "../lib/wa";
import WaIcon from "./WaIcon.astro";

const waGeneral = business.phone
  ? waLink(business.phone, business.orderTemplate.replace("{flavor}", "yang tersedia"))
  : "";

const nav = [
  { href: "#menu", label: "Menu" },
  { href: "#cara-pesan", label: "Cara Pesan" },
  { href: "#lokasi", label: "Lokasi" },
  { href: "#faq", label: "FAQ" },
];

const year = new Date().getFullYear();
---
<footer class="bg-cocoa pb-10 pt-14 text-cream md:pt-20">
  <div class="mx-auto max-w-[1200px] px-5">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="font-display text-3xl font-semibold">{business.name}</p>
        <p class="mt-3 max-w-sm leading-relaxed text-cream/80">{business.description}</p>
        {waGeneral && (
          <a
            href={waGeneral}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex min-h-11 items-center gap-2.5 rounded-full bg-marigold px-6 py-2.5 font-semibold text-cocoa transition-transform motion-safe:duration-300 motion-safe:hover:-translate-y-0.5"
          >
            <WaIcon class="h-4 w-4" />
            <span>Pesan via WhatsApp</span>
          </a>
        )}
      </div>

      <nav aria-label="Navigasi footer">
        <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-marigold">Jelajahi</h2>
        <ul class="mt-4 space-y-2">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="inline-flex min-h-11 items-center text-cream/80 transition-colors hover:text-marigold">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-marigold">Kunjungi</h2>
        <address class="mt-4 not-italic leading-relaxed text-cream/80">
          {business.address.street}<br />
          {business.address.city}, {business.address.province}
        </address>
        {business.hours.length > 0 && (
          <ul class="mt-4 space-y-1 text-cream/80">
            {business.hours.map((h) => (
              <li>{h.days} <span aria-hidden="true">·</span> {h.time}</li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-cream/15 pt-6 text-sm text-cream/70 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {business.name}. Wadai kelemben khas Banjarmasin.</p>
      <p>Foto placeholder: Unsplash &amp; Wikimedia Commons</p>
    </div>
  </div>
</footer>
