---
import { business } from "../data/business";
import { waLink } from "../lib/wa";
import WaIcon from "./WaIcon.astro";

const waGeneral = business.phone
  ? waLink(business.phone, business.orderTemplate.replace("{flavor}", "yang tersedia"))
  : "";

const nav = [
  { href: "/", label: "Beranda" },
  { href: "/katalog", label: "Katalog" },
  { href: "/tentang", label: "Tentang" },
  { href: "/lokasi", label: "Lokasi" },
  { href: "/keranjang", label: "Keranjang" },
];

const year = new Date().getFullYear();
---
<footer class="bg-cokelat pb-28 pt-14 text-susu md:pb-12 md:pt-20">
  <div class="mx-auto max-w-[1200px] px-5">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="display text-4xl font-semibold">{business.name}</p>
        <p class="mt-3 max-w-sm leading-relaxed text-susu/85">{business.description}</p>
        {waGeneral && (
          <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="btn btn-mentega mt-6">
            <WaIcon class="h-4 w-4" />
            <span>Pesan via WhatsApp</span>
          </a>
        )}
      </div>

      <nav aria-label="Navigasi footer">
        <h2 class="text-lg font-semibold text-mentega">Jelajahi</h2>
        <ul class="mt-4 space-y-1">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="inline-flex min-h-11 min-w-11 items-center text-susu/85 transition-colors hover:text-mentega">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="text-lg font-semibold text-mentega">Kunjungi</h2>
        <address class="mt-4 not-italic leading-relaxed text-susu/85">
          {business.address.street}<br />
          {business.address.city}, {business.address.province}
        </address>
        {business.hours.length > 0 && (
          <ul class="mt-4 space-y-1 text-susu/85">
            {business.hours.map((h) => (
              <li>{h.days}, pukul {h.time}</li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-susu/20 pt-6 text-sm text-susu/80 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {business.name}. Wadai kelemben khas Banjarmasin.</p>
      <p>Foto ilustrasi AI (Nano Banana) — ganti dengan foto asli sebelum publikasi</p>
    </div>
  </div>
</footer>
