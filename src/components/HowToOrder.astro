---
import { business } from "../data/business";
import { waLink } from "../lib/wa";
import WaIcon from "./WaIcon.astro";

const waGeneral = business.phone
  ? waLink(business.phone, business.orderTemplate.replace("{flavor}", "yang tersedia"))
  : "";

const fullAddress = [business.address.street, business.address.city]
  .filter(Boolean)
  .join(", ");

const steps = [
  {
    num: "01",
    title: "Pilih varian",
    text: "Tentukan rasa dan ukuran yang diinginkan — Original, Pandan, Coklat, atau Coklat Zebra.",
  },
  {
    num: "02",
    title: "Chat WhatsApp",
    text: "Kirim pesan lewat WhatsApp. Kami konfirmasi harga, ketersediaan, serta waktu ambil atau kirim.",
  },
  {
    num: "03",
    title: "Ambil atau kirim",
    text: `Ambil langsung di ${fullAddress}, atau kirim via Gojek/Grab/ekspedisi — opsi dan biaya dikonfirmasi via WhatsApp.`,
  },
];
---
<section id="cara-pesan" class="bg-cocoa py-16 text-cream md:py-24">
  <div class="mx-auto max-w-[1200px] px-5">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-marigold">Cara pesan</p>
      <h2 class="mt-3 font-display text-[clamp(2rem,5vw,3.25rem)] font-semibold leading-tight text-balance">
        Tiga langkah, tanpa ribet
      </h2>
    </div>

    <ol class="mt-10 grid gap-8 md:grid-cols-3">
      {steps.map((step) => (
        <li class="relative rounded-3xl border border-cream/15 bg-cream/[0.06] p-7">
          <span class="font-display text-5xl font-semibold text-marigold" aria-hidden="true">
            {step.num}
          </span>
          <h3 class="mt-4 font-display text-2xl font-semibold">{step.title}</h3>
          <p class="mt-3 leading-relaxed text-cream/85">{step.text}</p>
        </li>
      ))}
    </ol>

    {waGeneral && (
      <a
        href={waGeneral}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-10 inline-flex min-h-12 items-center gap-2.5 rounded-full bg-marigold px-7 py-3 font-semibold text-cocoa transition-transform motion-safe:duration-300 motion-safe:hover:-translate-y-0.5"
      >
        <WaIcon class="h-5 w-5" />
        <span>Pesan via WhatsApp</span>
      </a>
    )}
  </div>
</section>
