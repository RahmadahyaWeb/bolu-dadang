---
import { business } from "../data/business";
import { waLink } from "../lib/wa";
import WaIcon from "./WaIcon.astro";

const waGeneral = business.phone
  ? waLink(business.phone, business.orderTemplate.replace("{flavor}", "yang tersedia"))
  : "";

const fullAddress = [business.address.street, business.address.city]
  .filter(Boolean)
  .join(", ");

const steps = [
  {
    title: "Pilih varian",
    text: "Tentukan rasa dan ukuran yang diinginkan — Original, Pandan, Coklat, atau Coklat Zebra.",
  },
  {
    title: "Chat WhatsApp",
    text: "Kirim pesan lewat WhatsApp. Kami konfirmasi harga, ketersediaan, serta waktu ambil atau kirim.",
  },
  {
    title: "Ambil atau kirim",
    text: `Ambil langsung di ${fullAddress}, atau kirim via Gojek/Grab/ekspedisi — opsi dan biaya dikonfirmasi via WhatsApp.`,
  },
];
---
<section id="cara-pesan" class="bg-cokelat py-16 text-susu md:py-24">
  <div class="mx-auto max-w-[1200px] px-5">
    <h2 class="max-w-2xl text-[clamp(2.1rem,5.5vw,3.5rem)] font-semibold leading-[1.08] text-balance">
      Tiga langkah, tanpa ribet
    </h2>

    <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-10">
      {steps.map((step, i) => (
        <li class="border-t-2 border-mentega pt-6">
          <span class="display block text-[4.5rem] font-semibold leading-none text-mentega" aria-hidden="true">
            {i + 1}
          </span>
          <h3 class="mt-4 text-2xl font-semibold">{step.title}</h3>
          <p class="mt-3 leading-relaxed text-susu/85">{step.text}</p>
        </li>
      ))}
    </ol>

    {waGeneral && (
      <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="btn btn-mentega mt-12">
        <WaIcon class="h-5 w-5" />
        <span>Pesan via WhatsApp</span>
      </a>
    )}
  </div>
</section>
