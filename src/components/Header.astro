---
import { business } from "../data/business";
import { waLink } from "../lib/wa";
import WaIcon from "./WaIcon.astro";

const nav = [
  { href: "/", label: "Beranda" },
  { href: "/katalog", label: "Katalog" },
  { href: "/tentang", label: "Tentang" },
  { href: "/lokasi", label: "Lokasi" },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const waGeneral = business.phone
  ? waLink(business.phone, business.orderTemplate.replace("{flavor}", "yang tersedia"))
  : "";
---
<header class="sticky top-0 z-40 border-b border-cokelat/12 bg-kertas/92 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-3 px-5">
    <a href="/" class="display inline-flex min-h-11 items-center text-xl font-semibold tracking-tight">
      {business.shortName}
    </a>

    <nav aria-label="Navigasi utama" class="hidden items-center gap-8 text-sm font-medium md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? "page" : undefined}
          class:list={[
            "inline-flex min-h-11 items-center border-b-2 transition-colors hover:text-pandan",
            isCurrent(item.href) ? "border-mentega text-cokelat" : "border-transparent text-cokelat/85",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      {waGeneral && (
        <a
          href={waGeneral}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-mentega hidden min-h-11 px-5 text-sm sm:inline-flex"
        >
          <WaIcon class="h-4 w-4" />
          <span>Pesan via WhatsApp</span>
        </a>
      )}

      <button
        type="button"
        data-cart-open
        aria-haspopup="dialog"
        aria-label="Buka keranjang"
        class="relative inline-flex h-11 w-11 items-center justify-center rounded-full transition-colors hover:bg-cokelat/8"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6" aria-hidden="true" focusable="false">
          <path d="M6 8h12l-1 12H7L6 8Z" stroke-linejoin="round"></path>
          <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke-linecap="round"></path>
        </svg>
        <span
          data-cart-count
          hidden
          class="absolute -right-0.5 -top-0.5 flex h-5 min-w-5 items-center justify-center rounded-full bg-pandan px-1 text-xs font-semibold text-susu"
        >0</span>
      </button>

      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Buka menu"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full transition-colors hover:bg-cokelat/8 md:hidden"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="menu-mobile" data-nav-drawer hidden class="border-t border-cokelat/12 bg-kertas md:hidden">
    <nav aria-label="Navigasi seluler" class="mx-auto flex max-w-[1200px] flex-col px-5 py-3">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? "page" : undefined}
          class:list={[
            "inline-flex min-h-11 items-center border-b border-cokelat/10 py-1 text-lg",
            isCurrent(item.href) ? "font-semibold text-pandan" : "text-cokelat/85",
          ]}
        >
          {item.label}
        </a>
      ))}
      {waGeneral && (
        <a
          href={waGeneral}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-mentega mt-4 mb-2"
        >
          <WaIcon class="h-4 w-4" />
          <span>Pesan via WhatsApp</span>
        </a>
      )}
    </nav>
  </div>
</header>
