---
import { business } from "../data/business";
import { waLink } from "../lib/wa";
import WaIcon from "./WaIcon.astro";

const nav = [
  { href: "#menu", label: "Menu" },
  { href: "#cara-pesan", label: "Cara pesan" },
  { href: "#lokasi", label: "Lokasi" },
];

const waGeneral = business.phone
  ? waLink(business.phone, business.orderTemplate.replace("{flavor}", "yang tersedia"))
  : "";
---
<header
  data-header
  class="relative z-40 border-b border-cokelat/10 bg-kertas md:sticky md:top-0 md:bg-kertas/92 md:backdrop-blur-sm"
>
  <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-3 px-5 py-3">
    <a href="#konten" class="display inline-flex min-h-11 items-center text-xl font-semibold tracking-tight text-cokelat">
      {business.shortName}
    </a>

    <nav aria-label="Navigasi utama" class="hidden items-center gap-8 text-sm font-medium text-cokelat/85 md:flex">
      {nav.map((item) => (
        <a href={item.href} class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-md transition-colors hover:text-pandan">
          {item.label}
        </a>
      ))}
    </nav>

    {waGeneral && (
      <a
        href={waGeneral}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-mentega min-h-11 px-4 py-2 text-[13px] sm:px-5 sm:text-sm"
      >
        <WaIcon class="h-4 w-4" />
        <span>Pesan via WhatsApp</span>
      </a>
    )}
  </div>
</header>
