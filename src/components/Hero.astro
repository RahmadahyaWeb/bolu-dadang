---
import { Image } from "astro:assets";
import heroImg from "../assets/hero.jpg";
import { business } from "../data/business";
import { waLink } from "../lib/wa";
import WaIcon from "./WaIcon.astro";

const waGeneral = business.phone
  ? waLink(business.phone, business.orderTemplate.replace("{flavor}", "yang tersedia"))
  : "";

const fakta = [
  "Fresh dipanggang harian",
  "Wadai kelemben khas Banjarmasin",
  "Ambil di tempat atau dikirim lewat Gojek, Grab, dan ekspedisi",
];
---
<section data-hero class="relative overflow-hidden">
  <div class="mx-auto grid max-w-[1200px] items-center gap-12 px-5 pb-16 pt-10 md:grid-cols-[1.1fr_0.9fr] md:gap-14 md:pb-24 md:pt-16">
    <div>
      <h1
        class="rise rise-1 text-[clamp(2.6rem,8.5vw,5.25rem)] font-semibold leading-[1.02] tracking-tight text-balance"
      >
        {business.tagline}
      </h1>

      <p class="rise rise-2 mt-6 max-w-xl text-lg leading-relaxed text-cokelat/85">
        {business.description}
      </p>

      <div class="rise rise-3 mt-8 flex flex-wrap items-center gap-3">
        {waGeneral && (
          <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="btn btn-mentega">
            <WaIcon class="h-5 w-5" />
            <span>Pesan via WhatsApp</span>
          </a>
        )}
        <a href="#menu" class="btn btn-ghost">
          <span>Lihat menu</span>
        </a>
      </div>

      <ul class="rise rise-4 mt-9 space-y-2.5 border-l-4 border-mentega pl-5">
        {fakta.map((item) => (
          <li class="font-medium text-cokelat/90">{item}</li>
        ))}
      </ul>
    </div>

    <div class="rise rise-2 relative">
      <div class="stripe absolute inset-0 translate-x-4 translate-y-4" aria-hidden="true"></div>
      <Image
        src={heroImg}
        alt="Dua loyang bolu kelemben di atas tampah bambu beralas daun pisang"
        widths={[480, 768, 1120]}
        sizes="(min-width: 768px) 42vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="relative w-full object-cover shadow-[0_40px_70px_-40px_rgba(42,22,8,0.55)]"
      />
    </div>
  </div>
</section>
