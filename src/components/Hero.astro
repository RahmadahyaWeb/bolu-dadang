---
import { Image } from "astro:assets";
import heroImg from "../assets/hero.jpg";
import { business } from "../data/business";
import { waLink } from "../lib/wa";
import WaIcon from "./WaIcon.astro";

const waGeneral = business.phone
  ? waLink(business.phone, business.orderTemplate.replace("{flavor}", "yang tersedia"))
  : "";

const chips = ["Fresh dipanggang harian", "Khas Banjarmasin", "Pesan via WhatsApp"];
---
<section data-hero class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute -right-24 -top-24 h-[420px] w-[420px] rounded-full bg-marigold/25 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -left-32 top-64 h-[360px] w-[360px] rounded-full bg-pandan/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto grid max-w-[1200px] items-center gap-12 px-5 pb-16 pt-12 md:grid-cols-[1.05fr_1fr] md:pb-24 md:pt-20">
    <div>
      <p class="rise rise-1 text-sm font-semibold uppercase tracking-[0.18em] text-caramel">
        Wadai kelemben khas Banjarmasin
      </p>

      <h1
        class="rise rise-2 mt-4 font-display text-[clamp(2.5rem,7vw,4.5rem)] font-semibold leading-[1.03] tracking-tight text-balance"
      >
        {business.tagline}
      </h1>

      <p class="rise rise-3 mt-5 max-w-xl text-lg leading-relaxed text-cocoa/80">
        {business.description}
      </p>

      <div class="rise rise-4 mt-8 flex flex-wrap items-center gap-3">
        {waGeneral && (
          <a
            href={waGeneral}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 items-center gap-2.5 rounded-full bg-marigold px-7 py-3 font-semibold text-cocoa shadow-[0_16px_30px_-16px_rgba(232,163,61,0.9)] transition-transform motion-safe:duration-300 motion-safe:hover:-translate-y-0.5"
          >
            <WaIcon class="h-5 w-5" />
            <span>Pesan via WhatsApp</span>
          </a>
        )}
        <a
          href="#menu"
          class="inline-flex min-h-12 items-center gap-2 rounded-full border-2 border-cocoa/15 px-7 py-3 font-semibold text-cocoa transition-colors hover:border-pandan hover:text-pandan"
        >
          <span>Lihat Menu</span>
        </a>
      </div>

      <ul class="rise rise-5 mt-8 flex flex-wrap gap-2.5">
        {chips.map((chip) => (
          <li class="inline-flex items-center gap-2 rounded-full bg-butter px-4 py-2 text-sm font-medium text-cocoa/85">
            <svg class="h-4 w-4 text-pandan" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M7.6 13.6 4 10l-1.4 1.4 5 5 10-10-1.4-1.4z"></path>
            </svg>
            <span>{chip}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="rise rise-3 relative">
      <div
        class="absolute inset-0 translate-x-3 translate-y-3 rounded-[1.75rem] bg-pandan/20"
        aria-hidden="true"
      >
      </div>
      <Image
        src={heroImg}
        alt="Kelemben Bolu Dadang yang baru dipanggang di atas loyang"
        widths={[480, 768, 1120]}
        sizes="(min-width: 768px) 48vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="relative w-full rounded-[1.75rem] object-cover shadow-[0_40px_70px_-40px_rgba(46,27,15,0.55)]"
      />
    </div>
  </div>
</section>
