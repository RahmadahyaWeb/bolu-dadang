---
import { business } from "../data/business";
import { waLink } from "../lib/wa";
import WaIcon from "./WaIcon.astro";

const rupiah = (value: number) =>
  new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0,
  }).format(value);

const waGeneral = business.phone
  ? waLink(business.phone, business.orderTemplate.replace("{flavor}", "yang tersedia"))
  : "";
---
<section class="bg-mentega py-16 md:py-24">
  <div class="mx-auto max-w-[1200px] px-5">
    <h2 class="max-w-2xl text-[clamp(2.1rem,5.5vw,3.5rem)] font-semibold leading-[1.08] text-balance">
      Dua ukuran, sesuai kebutuhan Anda
    </h2>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-cokelat/90">
      Harga dikonfirmasi lewat WhatsApp sesuai varian dan jumlah pesanan.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {business.sizes.map((size) => (
        <article class="relative rounded-lg border-2 border-dashed border-cokelat/45 bg-kertas/85 p-8">
          <span class="absolute -top-3 left-1/2 h-6 w-6 -translate-x-1/2 rounded-full border-2 border-dashed border-cokelat/45 bg-mentega" aria-hidden="true"></span>
          <h3 class="mt-2 text-3xl font-semibold">{size.label}</h3>
          {size.note && <p class="mt-2 text-cokelat/85">{size.note}</p>}

          <p class="mt-5 text-lg font-semibold text-pandan">
            {size.priceFrom != null ? rupiah(size.priceFrom) : "Tanya harga via WhatsApp"}
          </p>

          {waGeneral && (
            <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="btn btn-pandan mt-5">
              <WaIcon class="h-4 w-4" />
              <span>Pesan via WhatsApp</span>
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
