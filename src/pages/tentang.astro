---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import WaIcon from "../components/WaIcon.astro";
import { business } from "../data/business";
import { products } from "../data/catalog";
import { waLink } from "../lib/wa";
import aboutImg from "../assets/about-texture.jpg";
import galleryImg from "../assets/gallery/05.jpg";

const title = `Tentang ${business.name}`;
const description =
  "Bolu Dadang membuat bolu kelemben di Banjarmasin: dipanggang harian, tekstur lembut, tersedia dalam empat varian. Pesan lewat WhatsApp.";

const waGeneral = business.phone
  ? waLink(business.phone, business.orderTemplate.replace("{flavor}", "yang tersedia"))
  : "";

const valueProps = [
  {
    title: "Dipanggang harian",
    body: "Setiap loyang dipanggang harian, jadi Anda kebagian kelemben yang masih fresh dari oven.",
  },
  {
    title: "Manisnya pas",
    body: "Rasa manisnya tidak berlebihan — enak untuk teman teh atau kopi sore.",
  },
  {
    title: "Untuk keluarga dan acara",
    body: "Cocok untuk camilan keluarga dan pesanan acara. Pesan jumlah banyak lewat WhatsApp.",
  },
];
---
<Layout title={title} description={description}>
  <div class="mx-auto max-w-[1200px] px-5 pt-8">
    <Breadcrumbs items={[{ label: "Beranda", href: "/" }, { label: "Tentang" }]} />
  </div>

  <section class="pb-16 pt-6 md:pb-24">
    <div class="mx-auto max-w-[1200px] px-5">
      <h1 class="max-w-3xl text-[clamp(2.3rem,6vw,3.8rem)] font-semibold leading-[1.08] text-balance">
        Tentang {business.name}
      </h1>

      <div class="mt-10 grid gap-10 md:grid-cols-[1.2fr_1fr] md:gap-14">
        <div class="space-y-5 text-lg leading-relaxed text-cokelat/85">
          <p>
            {business.name} membuat bolu kelemben di {business.address.city}. Kelemben kami
            dipanggang harian — lembut, dengan rongga halus, dan dipotong tebal supaya mudah
            disantap bersama teh atau kopi.
          </p>
          <p>
            Ada empat varian yang bisa dipilih: {products.map((p) => p.flavor).join(", ")}.
            Setiap varian punya karakternya sendiri, dari aroma mentega dan vanila sampai motif
            zebra coklat berlapis.
          </p>
          <p>
            Pemesanan lewat WhatsApp. Anda bisa ambil sendiri di tempat atau minta kirim — harga
            dan ketersediaan selalu dikonfirmasi dulu sebelum pesanan diproses.
          </p>
          {waGeneral && (
            <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="btn btn-mentega">
              <WaIcon class="h-4 w-4" />
              <span>Pesan via WhatsApp</span>
            </a>
          )}
        </div>

        <div class="space-y-5">
          <Image
            src={aboutImg}
            alt="Tekstur crumb bolu kelemben dari dekat"
            widths={[640, 1024]}
            sizes="(max-width: 900px) 92vw, 480px"
            class="aspect-[4/3] w-full rounded-md border border-cokelat/12 object-cover"
          />
          <Image
            src={galleryImg}
            alt="Tumpukan irisan bolu kelemben di atas daun pisang"
            widths={[640, 1024]}
            sizes="(max-width: 900px) 92vw, 480px"
            loading="lazy"
            class="aspect-[4/3] w-full rounded-md border border-cokelat/12 object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-susu py-16 md:py-24">
    <div class="mx-auto max-w-[1200px] px-5">
      <h2 class="text-[clamp(1.9rem,4.5vw,2.8rem)] font-semibold leading-tight">
        Cara kami membuat kelemben
      </h2>
      <div class="mt-10 grid gap-8 border-t border-cokelat/12 pt-10 md:grid-cols-3">
        {valueProps.map((prop) => (
          <div class="border-l-2 border-mentega pl-6">
            <h3 class="text-xl font-semibold">{prop.title}</h3>
            <p class="mt-3 leading-relaxed text-cokelat/85">{prop.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
