---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FilterPills from "../components/FilterPills.astro";
import ProductCard from "../components/ProductCard.astro";
import { business } from "../data/business";
import { products } from "../data/catalog";
import { href } from "../lib/path";

const title = `Katalog Kelemben — ${business.name}`;
const description =
  "Empat varian bolu kelemben Bolu Dadang: Original, Pandan, Coklat, dan Coklat Zebra. Pesan lewat WhatsApp, ambil di tempat atau kirim.";

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Beranda", item: new URL(href("/"), Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Katalog", item: new URL(href("/katalog"), Astro.site).href },
  ],
};
---
<Layout title={title} description={description} jsonLd={[breadcrumbLd]}>
  <div class="mx-auto max-w-[1200px] px-5 pt-8">
    <Breadcrumbs items={[{ label: "Beranda", href: "/" }, { label: "Katalog" }]} />
  </div>

  <section class="pb-16 pt-6 md:pb-24">
    <div class="mx-auto max-w-[1200px] px-5">
      <h1 class="text-[clamp(2.3rem,6vw,3.8rem)] font-semibold leading-[1.08] text-balance">
        Katalog kelemben
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-cokelat/85">
        Pilih varian yang Anda suka. Harga dikonfirmasi lewat WhatsApp sebelum pesanan diproses.
      </p>

      <div class="mt-8">
        <FilterPills />
      </div>

      <div class="mt-10 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3" data-product-grid>
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>
</Layout>
