---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import WaIcon from "../components/WaIcon.astro";
import { business } from "../data/business";
import { waLink } from "../lib/wa";
import { href } from "../lib/path";

const title = `Lokasi & Kontak — ${business.name}`;
const description =
  "Ambil pesanan di Komplek Sejahtera Mandiri Asri Blok D No. 115, Banjarmasin. Buka setiap hari 10.00–17.00 WITA. Pengiriman via Gojek, Grab, atau ekspedisi.";

const waGeneral = business.phone
  ? waLink(business.phone, business.orderTemplate.replace("{flavor}", "yang tersedia"))
  : "";

const localBusinessLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: business.name,
  description: business.description,
  image: new URL(href("/og.jpg"), Astro.site).href,
  url: new URL(href("/lokasi"), Astro.site).href,
  ...(business.phone ? { telephone: `+${business.phone}` } : {}),
  address: {
    "@type": "PostalAddress",
    streetAddress: [business.address.street, business.address.district]
      .filter(Boolean)
      .join(", "),
    addressLocality: business.address.city,
    addressRegion: business.address.province,
    ...(business.address.postalCode ? { postalCode: business.address.postalCode } : {}),
    addressCountry: "ID",
  },
  openingHours: business.hours.map((h) => `${h.days} ${h.time}`),
};
---
<Layout title={title} description={description} jsonLd={[localBusinessLd]}>
  <div class="mx-auto max-w-[1200px] px-5 pt-8">
    <Breadcrumbs items={[{ label: "Beranda", href: "/" }, { label: "Lokasi" }]} />
  </div>

  <section class="pb-16 pt-6 md:pb-24">
    <div class="mx-auto max-w-[1200px] px-5">
      <h1 class="max-w-3xl text-[clamp(2.3rem,6vw,3.8rem)] font-semibold leading-[1.08] text-balance">
        Lokasi & jam buka
      </h1>

      <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-14">
        <div>
          <h2 class="text-2xl font-semibold">Alamat</h2>
          <address class="mt-4 not-italic text-lg leading-relaxed text-cokelat/85">
            {business.address.street}<br />
            {[business.address.district, business.address.city].filter(Boolean).join(", ")}<br />
            {business.address.province}
            {business.address.postalCode && <>, {business.address.postalCode}</>}
          </address>

          <h2 class="mt-8 text-2xl font-semibold">Jam buka</h2>
          <ul class="mt-4 space-y-1 text-lg text-cokelat/85">
            {business.hours.map((h) => (
              <li>{h.days}, pukul {h.time}</li>
            ))}
          </ul>

          <h2 class="mt-8 text-2xl font-semibold">Ambil di tempat & pengiriman</h2>
          <div class="mt-4 space-y-4 text-lg leading-relaxed text-cokelat/85">
            <p>
              Ambil sendiri di alamat di atas, setiap hari pukul {business.hours[0]?.time}.
            </p>
            <p>
              Bisa dikirim lewat Gojek, Grab, atau ekspedisi. Biaya dan kemasan dikonfirmasi lewat
              WhatsApp sebelum pesanan diproses.
            </p>
          </div>

          {waGeneral && (
            <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="btn btn-mentega mt-8">
              <WaIcon class="h-4 w-4" />
              <span>Pesan via WhatsApp</span>
            </a>
          )}
        </div>

        <figure>
          <img
            src={href("/map.jpg")}
            alt={`Peta lokasi ${business.name} di ${business.address.city}`}
            width="1200"
            height="800"
            loading="lazy"
            class="w-full rounded-md border border-cokelat/12 object-cover"
          />
          <figcaption class="mt-3 text-sm leading-relaxed text-karamel">
            Peta ©{" "}
            <a
              href="https://www.openstreetmap.org/copyright"
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-4 hover:text-pandan"
            >kontributor OpenStreetMap</a>.{" "}
            <a
              href={business.address.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-4 hover:text-pandan"
            >Buka lokasi di OpenStreetMap</a>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>
</Layout>
