---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { business } from "../data/business";
import { waLink } from "../lib/wa";

const title = `Konfirmasi Pesanan — ${business.name}`;
const description =
  "Isi data pesanan Anda, lalu kirim ringkasan pesanan ke WhatsApp Bolu Dadang. Konfirmasi harga dan ketersediaan dilakukan di chat.";

const waGeneral = business.phone
  ? waLink(business.phone, business.orderTemplate.replace("{flavor}", "yang tersedia"))
  : "";

// Batas tanggal = hari ini (WITA).
const today = new Date(Date.now() + 8 * 3600 * 1000).toISOString().slice(0, 10);
---
<Layout title={title} description={description} floatingWa={false}>
  <div class="mx-auto max-w-[1200px] px-5 pt-8">
    <Breadcrumbs items={[{ label: "Beranda", href: "/" }, { label: "Konfirmasi pesanan" }]} />
  </div>

  <section class="pb-16 pt-6 md:pb-24">
    <div class="mx-auto max-w-[1200px] px-5">
      <h1 class="text-[clamp(2.3rem,6vw,3.8rem)] font-semibold leading-[1.08]">
        Konfirmasi pesanan
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-cokelat/85">
        Pesanan Anda dikirim sebagai pesan WhatsApp. Harga, ketersediaan, dan ongkir dikonfirmasi
        di chat sebelum pesanan diproses.
      </p>

      <noscript>
        <p class="mt-6 rounded-md border border-cokelat/20 bg-susu/70 p-5 leading-relaxed">
          Formulir ini butuh JavaScript di browser Anda.
          {waGeneral ? (
            <>Untuk pesan langsung,{" "}
              <a
                href={waGeneral}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-pandan underline decoration-mentega decoration-2 underline-offset-4"
              >chat kami di WhatsApp</a>.
            </>
          ) : (
            "Nomor WhatsApp belum tersedia."
          )}
        </p>
      </noscript>

      <div class="mt-10 grid gap-12 lg:grid-cols-[1.3fr_1fr]">
        <form data-checkout-form novalidate onsubmit="return false">
          <h2 class="text-2xl font-semibold">Data pemesan</h2>

          <div class="mt-6 space-y-6">
            <div>
              <label class="label" for="nama">Nama <span class="text-galat" aria-hidden="true">*</span></label>
              <input class="field" type="text" id="nama" name="nama" autocomplete="name" required
                aria-describedby="error-nama" placeholder="Nama Anda" />
              <p class="error-text" id="error-nama" data-error-for="nama" role="alert"></p>
            </div>

            <div>
              <label class="label" for="telepon">Nomor WhatsApp <span class="text-galat" aria-hidden="true">*</span></label>
              <input class="field" type="tel" id="telepon" name="telepon" autocomplete="tel" required
                aria-describedby="error-telepon" placeholder="081234567890" />
              <p class="error-text" id="error-telepon" data-error-for="telepon" role="alert"></p>
            </div>

            <fieldset aria-describedby="error-mode">
              <legend class="label">Pengambilan <span class="text-galat" aria-hidden="true">*</span></legend>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class="flex cursor-pointer items-start gap-3 rounded-md border border-cokelat/25 p-4">
                  <input type="radio" name="mode" value="pickup" class="mt-1 h-5 w-5 accent-[#2F5D3B]" />
                  <span>
                    <span class="font-semibold">Ambil di tempat</span>
                    <span class="mt-1 block text-sm text-karamel">Ambil di {business.address.street}, {business.address.city}.</span>
                  </span>
                </label>
                <label class="flex cursor-pointer items-start gap-3 rounded-md border border-cokelat/25 p-4">
                  <input type="radio" name="mode" value="delivery" class="mt-1 h-5 w-5 accent-[#2F5D3B]" />
                  <span>
                    <span class="font-semibold">Kirim</span>
                    <span class="mt-1 block text-sm text-karamel">Biaya kirim dikonfirmasi via WhatsApp.</span>
                  </span>
                </label>
              </div>
              <p class="error-text" id="error-mode" data-error-for="mode" role="alert"></p>
            </fieldset>

            <div>
              <label class="label" for="tanggal">Tanggal kebutuhan <span class="text-karamel">(opsional)</span></label>
              <input class="field" type="date" id="tanggal" name="tanggal" min={today} />
            </div>

            <div data-address-field>
              <label class="label" for="alamat">Alamat pengiriman <span class="text-karamel">(opsional, dikonfirmasi via WhatsApp)</span></label>
              <textarea class="field" id="alamat" name="alamat" rows="3" placeholder="Jalan, nomor rumah, patokan"></textarea>
            </div>

            <div>
              <label class="label" for="catatan">Catatan <span class="text-karamel">(opsional)</span></label>
              <textarea class="field" id="catatan" name="catatan" rows="3" placeholder="Contoh: potong jadi 8 bagian"></textarea>
            </div>
          </div>

          {business.phone ? (
            <button type="submit" data-checkout-submit class="btn btn-pandan mt-8 w-full sm:w-auto">
              Kirim pesanan via WhatsApp
            </button>
          ) : (
            <p class="error-text mt-8">Nomor WhatsApp belum tersedia.</p>
          )}
          <p class="error-text" data-error-for="keranjang" role="alert"></p>
          <p class="mt-4 text-sm leading-relaxed text-karamel">
            Data Anda hanya dirangkai menjadi pesan WhatsApp di browser, tidak disimpan di situs ini.
          </p>
        </form>

        <aside>
          <h2 class="text-2xl font-semibold">Ringkasan pesanan</h2>
          <div class="mt-6 rounded-md border border-cokelat/12 bg-susu/60 p-5" data-checkout-summary>
            <!-- Dirender oleh src/scripts/site.ts. -->
            <p class="font-medium">Keranjang Anda masih kosong.</p>
            <a href="/katalog" class="btn btn-mentega mt-4">Lihat katalog</a>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-karamel">
            Pembayaran dan ongkir dikonfirmasi lewat WhatsApp.
          </p>
        </aside>
      </div>
    </div>
  </section>
</Layout>
